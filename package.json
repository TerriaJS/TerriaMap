{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/terriajs",
      "packages/terriajs-cesium1/packages/engine",
      "packages/terriajs-cesium1/packages/widgets",
      "packages/terriajs-server",
      "packages/plugin-sample"
    ],
    "nohoist": [
      "**/husky"
    ]
  },
  "name": "terriajs-map",
  "version": "0.4.5",
  "description": "Geospatial catalog explorer based on TerriaJS.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/TerriaJS/TerriaMap"
  },
  "dependencies": {
    "@types/jasmine": "^6.0.0",
    "jasmine-browser-runner": "^4.0.0",
    "jasmine-core": "^6.1.0",
    "terriajs-server": "^4.0.3"
  },
  "config": {
    "docker": {
      "name": "terriamap",
      "include": "wwwroot node_modules serverconfig.json index.js package.json version.js",
      "dockerfile": "deploy/docker/Dockerfile"
    }
  },
  "resolutions": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fetch-mock": "^11.1.5",
    "fs-extra": "^7.0.1",
    "gulp": "^5.0.0",
    "husky": "^8.0.3",
    "is-subdir": "^1.2.0",
    "json5": "^2.1.0",
    "lodash": "^4.17.21",
    "plugin-error": "^2.0.1",
    "prettier": "2.8.8",
    "pretty-quick": "^4.0.0",
    "prop-types": "^15.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.81.0",
    "svg-sprite": "^2.0.4",
    "terriajs": "8.11.3",
    "terriajs-cesium": "23.0.0",
    "terriajs-plugin-api": "0.0.1-alpha.17",
    "terriajs-plugin-sample": "0.0.1-alpha.7",
    "typescript": "^5.9.2",
    "urijs": "^1.18.12",
    "vite": "^8.0.0",
    "vite-css-modules": "^1.14.0",
    "vite-plugin-static-copy": "^3.3.0",
    "yargs": "^17.7.2"
  },
  "scripts": {
    "prepare": "husky install",
    "docker-build-local": "node deploy/docker/create-docker-context.js --build --push --tag auto --local",
    "docker-build-prod": "node deploy/docker/create-docker-context.js --build --push --tag auto --repository=ghcr.io/terriajs",
    "docker-build-ci": "node deploy/docker/create-docker-context.js --build",
    "start": "terriajs-server --config-file serverconfig.json",
    "gulp": "gulp",
    "postinstall": "echo 'Installation successful. What to do next:\\n  yarn gulp dev   # Starts the server on port 3001, builds TerriaMap and dependencies, and rebuilds if files change.'",
    "prettier": "prettier --write .",
    "prettier-check": "prettier --check ."
  }
}
